extends Node
## Sound playback with a small voice pool (autoload "Sfx").
## WAVs are generated by tools/gen_sfx.py.

const NAMES := ["shot", "boom1", "boom2", "destroy", "click", "beep",
	"thud", "win", "sting", "title_theme"]
const POOL_SIZE := 8

var streams := {}
var pool: Array = []
var idx := 0
var music_player: AudioStreamPlayer
var music_name := ""


func _ready() -> void:
	for n in NAMES:
		var path := "res://assets/sfx/%s.wav" % n
		if ResourceLoader.exists(path):
			streams[n] = load(path)
	for i in POOL_SIZE:
		var p := AudioStreamPlayer.new()
		add_child(p)
		pool.append(p)
	music_player = AudioStreamPlayer.new()
	add_child(music_player)
	music_player.finished.connect(_loop_music)


func play_music(name: String, vol_db := -6.0) -> void:
	if not streams.has(name):
		return
	if music_name == name and music_player.playing:
		return
	music_name = name
	music_player.stream = streams[name]
	music_player.volume_db = vol_db
	music_player.play()


func _loop_music() -> void:
	if music_name != "":
		music_player.play()


## iOS browsers keep audio locked until the first user gesture; music that
## started while locked stays silent. Called on the first tap to restart it.
func unlock_retrigger() -> void:
	if music_name != "" and music_player != null:
		music_player.play()


func stop_music() -> void:
	music_name = ""
	music_player.stop()


func play(name: String, vol_db := 0.0, pitch := 1.0) -> void:
	if not streams.has(name):
		return
	var p: AudioStreamPlayer = pool[idx]
	idx = (idx + 1) % POOL_SIZE
	p.stream = streams[name]
	p.volume_db = vol_db
	p.pitch_scale = pitch
	p.play()
